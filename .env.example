# ============================================
# TheCloeIntegration - Variables de Entorno
# Copiar este archivo como .env y llenar los valores reales
# ============================================

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-en-produccion
DEBUG=True
ALLOWED_HOSTS=*,localhost

# Database - SQL Server (EJECUCIÓN LOCAL)
# SQL Server corre en tu máquina, Django en Docker se conecta vía host.docker.internal
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=the_cloe
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# SimpleAPI (SII)
SIMPLEAPI_KEY=tu-api-key-aqui
SIMPLEAPI_BASE_URL=https://api.simpleapi.cl/api/v1
SIMPLEAPI_TIMEOUT=30

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO

# SimpleFactura (emisión de DTE, FASE 2)
SIMPLEFACTURA_EMAIL=
SIMPLEFACTURA_PASSWORD=
SIMPLEFACTURA_BASE_URL=https://api.simplefactura.cl
SIMPLEFACTURA_SUCURSAL=Casa_Matriz
SIMPLEFACTURA_MODE=simulate
