FROM python:3.12-slim-bookworm

# Instalar ODBC Driver 18 (+17 por compatibilidad) y mssql-tools18 para diagnostico
RUN apt-get update && \
    apt-get install -y curl gnupg unixodbc unixodbc-dev && \
    curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && \
    echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" > /etc/apt/sources.list.d/mssql-release.list && \
    apt-get update && \
    ACCEPT_EULA=Y apt-get install -y msodbcsql18 msodbcsql17 mssql-tools18 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/mssql-tools18/bin:${PATH}"

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY ./backend/ .

EXPOSE 8000

CMD ["sh", "-c", "python wait_for_db.py 20 3 && (python manage.py makemigrations --dry-run --check || echo '[WARN] Hay modelos sin migraciones pendientes; ejecutando migrate igualmente.') ; python manage.py migrate --noinput && python manage.py runserver 0.0.0.0:8000"]
