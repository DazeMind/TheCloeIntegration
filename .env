# Django
DJANGO_SECRET_KEY=thecloe-dev-secret-key-change-me
DEBUG=True
ALLOWED_HOSTS=*,localhost

# Database - SQL Server (LOCAL)
DB_HOST=127.0.0.1
DB_NAME=the_cloe
DB_PORT=1433
DB_USER=TestLocal
DB_PASSWORD=TestLocal
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENGINE=mssql
SSL_REQUIRED=0 
DB_OPTIONS_EXTRA_PARAMS=TrustServerCertificate=yes

# SimpleAPI (SII)
SIMPLEAPI_KEY=your-simpleapi-key
SIMPLEAPI_BASE_URL=https://api.simpleapi.cl/api/v1
SIMPLEAPI_TIMEOUT=30

# Circuit Breaker
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# CORS
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=INFO
